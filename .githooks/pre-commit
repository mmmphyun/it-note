#!/bin/sh
# It!note Hard Guard (pre-commit)
# 스택: TypeScript Monorepo (Svelte 5 Frontend + Hono Backend)
# 목적: Private 개발 후 Public 전환 시 히스토리 오염 방지 및 아키텍처 불변성 강제

set -e

echo "[Hard Guard] Running pre-commit verification..."

# 1. .env 파일 스테이징 원천 차단
STAGED_ENV=$(git diff --cached --name-only | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' || true)
if [ -n "$STAGED_ENV" ]; then
  echo "[BLOCKED] .env 파일은 절대 커밋할 수 없습니다: $STAGED_ENV"
  exit 1
fi

# 2. Gitleaks 시크릿 및 엔트로피 스캔 (Staged 변경분 대상)
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --config .gitleaks.toml --verbose
else
  echo "[BLOCKED] gitleaks 바이너리가 설치되어 있지 않습니다. 시크릿 검사를 우회할 수 없습니다."
  exit 1
fi

# 3. 원자적 커밋(Atomic Commit) 파일 개수 제한 (최대 10개)
STAGED_COUNT=$(git diff --cached --name-only | wc -l | tr -d ' ')
if [ "$STAGED_COUNT" -gt 10 ]; then
  echo "[BLOCKED] 한 번에 너무 많은 파일($STAGED_COUNT개)이 스테이징되었습니다. 1-Task 1-Commit 원칙에 따라 10개 이하로 분할 커밋하십시오."
  exit 1
fi

# 4. Zero-UI 아키텍처 불변성 검사 (frontend 캔버스 컴포넌트 내 금지된 UI 태그 차단)
CANVAS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(apps/web|frontend)/src/lib/canvas/.*\.(svelte|ts)$' || true)
if [ -n "$CANVAS_FILES" ]; then
  FORBIDDEN_UI=$(grep -En '<(header|footer|nav|button|input|select|textarea)\b' $CANVAS_FILES || true)
  if [ -n "$FORBIDDEN_UI" ]; then
    echo "[BLOCKED] Zero-UI 원칙 위반: 캔버스 컴포넌트 내부에 일반 UI 컨트롤 태그(<header>, <footer>, <nav>, <button>, <input> 등)를 사용할 수 없습니다."
    echo "$FORBIDDEN_UI"
    exit 1
  fi
fi

# 5. 원본 필기 이미지 디스크 저장 차단 (서버 로컬 파일시스템 덤프 금지)
API_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(apps/server|backend)/src/.*\.(ts|js)$' || true)
if [ -n "$API_FILES" ]; then
  FORBIDDEN_FS=$(grep -En '\b(writeFile|writeFileSync|appendFile|appendFileSync|createWriteStream)\b' $API_FILES || true)
  if [ -n "$FORBIDDEN_FS" ]; then
    echo "[BLOCKED] 보안 원칙 위반: 백엔드 서버에서 사용자의 원본 필기 이미지를 로컬 디스크 파일(writeFile 등)로 저장할 수 없습니다."
    echo "$FORBIDDEN_FS"
    exit 1
  fi
fi

# 6. TypeScript / Svelte 타입 무결성 검사 (루트 package.json 및 node_modules 존재 시)
if [ -f "package.json" ] && [ -d "node_modules" ]; then
  echo "[Hard Guard] Running workspace typecheck (npm run check)..."
  npm run check --if-present
fi

# 7. Vitest 단위 테스트 회귀 방지 검사 (테스트 실패 시 커밋 원천 차단)
if [ -f "package.json" ] && [ -d "node_modules" ]; then
  if grep -q '"test"' package.json; then
    echo "[Hard Guard] Running unit tests (npm test -- --run)..."
    npm test -- --run
  fi
fi

echo "[Hard Guard] All checks passed."
