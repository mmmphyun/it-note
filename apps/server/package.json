{
  "name": "@itnote/server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/functions.cjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:functions": "esbuild src/functions.ts --bundle --platform=node --target=node22 --format=cjs --outfile=deploy/index.cjs --external:firebase-admin --external:firebase-functions",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@hono/node-server": "^1.13.7",
    "@itnote/shared": "*",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
